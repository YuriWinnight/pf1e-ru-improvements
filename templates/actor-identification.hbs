<section class="pf1e-ru-identification-root">
  <header class="pf1e-ru-identification-actor">
    <img src="{{actor.img}}" alt="">
    <div>
      <h2>{{actor.name}}</h2>
      <p>Проверку выполняет владелец этого листа. Колдовство: <b>{{spellcraftBonus}}</b>.</p>
    </div>
    {{#if canRoll}}
    <button type="button" data-action="roll-identification" title="Выполнить проверки Колдовства">
      <i class="fas fa-dice-d20"></i> Проверить опознание
    </button>
    {{/if}}
  </header>

  <section class="pf1e-ru-identification-section">
    <h2>Неопознанные предметы</h2>
    <div class="pf1e-ru-identification-table {{#unless showIdentifyDC}}pf1e-ru-identification-dc-hidden{{/unless}}">
      <div class="pf1e-ru-identification-row pf1e-ru-identification-head">
        <span>Предмет</span><span>Аура</span><span>УЗ</span>{{#if showIdentifyDC}}<span>СЛ Опознания</span>{{/if}}<span>Опознание</span>
      </div>
      {{#if unidentified.length}}
      {{#each unidentified}}
      <div class="pf1e-ru-identification-row" data-item-id="{{id}}">
        <button type="button" class="pf1e-ru-identification-item" data-action="open-item" data-item-id="{{id}}" title="Открыть предмет">
          <img src="{{img}}" alt=""><span>{{name}}{{#if ../showCurseDetails}}{{#if cursed}}<small class="pf1e-ru-cursed-item-label"><i class="fas fa-skull"></i> Проклято</small>{{/if}}{{/if}}</span>
        </button>
        <span>{{aura}}</span><span>{{casterLevel}}</span>{{#if ../showIdentifyDC}}<span>{{identifyDC}}</span>{{/if}}
        <span class="pf1e-ru-identification-action">
        {{#if ../canToggle}}
        <button type="button" class="pf1e-ru-identification-toggle" data-action="toggle-identification" data-item-id="{{id}}" title="Опознать без проверки"><i class="fas fa-eye"></i></button>
        {{/if}}
        </span>
      </div>
      {{/each}}
      {{else}}
      <div class="pf1e-ru-identification-empty">Неопознанных магических предметов нет.</div>
      {{/if}}
    </div>
  </section>

  <section class="pf1e-ru-identification-section">
    <h2>Опознанные предметы</h2>
    <div class="pf1e-ru-identification-table {{#unless showIdentifyDC}}pf1e-ru-identification-dc-hidden{{/unless}}">
      <div class="pf1e-ru-identification-row pf1e-ru-identification-head">
        <span>Предмет</span><span>Аура</span><span>УЗ</span>{{#if showIdentifyDC}}<span>СЛ Опознания</span>{{/if}}<span>Опознание</span>
      </div>
      {{#if identified.length}}
      {{#each identified}}
      <div class="pf1e-ru-identification-row" data-item-id="{{id}}">
        <button type="button" class="pf1e-ru-identification-item" data-action="open-item" data-item-id="{{id}}" title="Открыть предмет">
          <img src="{{img}}" alt=""><span>{{name}}{{#if ../showCurseDetails}}{{#if cursed}}<small class="pf1e-ru-cursed-item-label"><i class="fas fa-skull"></i> Проклято{{#if curseIdentified}} — опознано{{else}} — скрыто{{/if}}</small>{{/if}}{{/if}}</span>
        </button>
        <span>{{aura}}</span><span>{{casterLevel}}</span>{{#if ../showIdentifyDC}}<span>{{identifyDC}}</span>{{/if}}
        <span class="pf1e-ru-identification-action">
        {{#if ../canToggle}}
        <button type="button" class="pf1e-ru-identification-toggle" data-action="toggle-identification" data-item-id="{{id}}" title="Сделать неопознанным"><i class="fas fa-eye-slash"></i></button>
        {{/if}}
        </span>
      </div>
      {{/each}}
      {{else}}
      <div class="pf1e-ru-identification-empty">Опознанных магических предметов нет.</div>
      {{/if}}
    </div>
  </section>
</section>
